model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Functions and Parameters'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Data References'

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["COVID","StateDim","Table","COVID measures","US Counties","Calendar_Raw","Start Date","fxGetReportDetails","fxCountryCorrections"]

annotation PBI_ProTooling = ["DevMode","TMDL-Extension","DaxQueryView_Desktop"]

ref table COVID
ref table StateDim
ref table Table
ref table 'COVID measures'
ref table Calendar

ref cultureInfo en-US
ref cultureInfo es-ES

